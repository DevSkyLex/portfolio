# Trust only the reviewed Traefik address. Other containers on the shared network cannot supply a
# client address or reach the origin. Health checks use the separate loopback-only server.
geo $realip_remote_addr $trusted_edge {
  default 0;
  ${TRUSTED_PROXIES} 1;
}

server {
  listen ${APP_PORT};
  server_name ${APP_HOST} www.${APP_HOST};
  # Relative application redirects must not expose the HTTP origin's internal port.
  absolute_redirect off;

  set_real_ip_from ${TRUSTED_PROXIES};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  set $external_scheme https;

  if ($trusted_edge = 0) {
    return 444;
  }

  if ($host != ${APP_HOST}) {
    return 301 https://${APP_HOST}$request_uri;
  }

  include /etc/nginx/snippets/security-headers.conf;
  include /etc/nginx/snippets/site.conf;
}
