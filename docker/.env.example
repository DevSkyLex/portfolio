# Public configuration only. Ansible writes docker/.env on the server.
# APP_PORT is the origin's container port; no host port is published.
COMPOSE_PROJECT_NAME=portfolio
CONTAINER_NAME=portfolio
APP_HOST=valentin-fortin.pro
APP_PORT=80
TRAEFIK_ROUTER_NAME=portfolio
TRAEFIK_SECURE_MIDDLEWARES=
# One reviewed Traefik IPv4/IPv6 address or narrow CIDR, never the whole shared Docker network.
# Required: obtain this from the existing proxy configuration. No guessed subnet default.
TRUSTED_PROXIES=
WEB_MEMORY_LIMIT=128M
WEB_CPU_LIMIT=1.0
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_LEVEL=info
SITE_ROOT=/srv/apps/portfolio/production/site
# Uploaded images (D40): written by content-service, read by Nginx.
MEDIA_ROOT=/srv/apps/portfolio/production/media
# Three independent service images share a registry and immutable commit tag.
REGISTRY=ghcr.io/devskylex
TAG=0000000
IDENTITY_SIGNING_KID=k1
SITE_BUILD_REPOSITORY=DevSkyLex/portfolio
# SEO dashboard (D47), all optional: Search Console property (sc-domain:<domain> or a URL prefix
# ending with /), numeric GA4 property id, comma-separated key URLs for PageSpeed Insights.
SEO_SEARCH_CONSOLE_PROPERTY=
SEO_GA4_PROPERTY_ID=
SEO_WEB_VITALS_URLS=
CONTACT_MAIL_FROM='Portfolio <noreply@send.valentin-fortin.pro>'
CONTACT_NOTIFY_TO=contact@valentin-fortin.pro
