# {{ ansible_managed }}
[Unit]
Description=Portfolio restore test of the latest backup ({{ app_root }}/scripts/restore-check.sh)
Requires=docker.service
After=docker.service portfolio-backup.service

[Service]
Type=oneshot
User={{ deploy_user }}
Group={{ deploy_user }}
ExecStart=/usr/bin/bash {{ app_root }}/scripts/restore-check.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
