# {{ ansible_managed }}
[Unit]
Description=Portfolio database backup ({{ app_root }}/scripts/backup.sh)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User={{ deploy_user }}
Group={{ deploy_user }}
ExecStart=/usr/bin/bash {{ app_root }}/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
