# Development without Docker: copy to .env (not versioned). Production values come from Docker secrets.
IDENTITY_PORT=3103
IDENTITY_DATABASE_URL=pglite:.data/identity
# Ed25519 keys `<kid>.pem`, created by `npx nx run identity-service:generate-key`.
IDENTITY_KEYS_DIR=.data/identity-keys
IDENTITY_SIGNING_KID=dev-1
IDENTITY_ISSUER=http://localhost:4200/api/auth
# MCP resource of the OAuth server (D45); defaults to the issuer's origin + /api/content/mcp.
# IDENTITY_MCP_RESOURCE=http://localhost:4200/api/content/mcp
# Plain HTTP in development only.
IDENTITY_COOKIE_SECURE=false
LOG_LEVEL=info
NODE_ENV=development
