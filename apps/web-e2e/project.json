{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "tags": ["scope:app", "platform:neutral", "layer:e2e"],
  "implicitDependencies": ["web"],
  "targets": {
    "e2e-stack": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["test-tooling"],
      "options": { "command": "node apps/web-e2e/support/stack/run-stack-e2e.mjs" }
    },
    "test-tooling": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/support/**/*.mjs", "sharedGlobals"],
      "options": {
        "command": "node --test apps/web-e2e/support/preview/testing/serve-site.test.mjs apps/web-e2e/support/stack/testing/run-stack-e2e.test.mjs"
      }
    },
    "e2e": {
      "dependsOn": [
        "test-tooling",
        {
          "projects": ["web"],
          "target": "build"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web-e2e/tsconfig.json --noEmit"
      }
    }
  }
}
