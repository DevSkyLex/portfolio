# Development without Docker: copy to .env (not versioned). Production values come from Docker secrets.
CONTENT_PORT=3101
CONTENT_DATABASE_URL=pglite:.data/content
# Same issuer as IDENTITY_ISSUER; JWKS read directly from the identity service.
AUTH_ISSUER=http://localhost:4200/api/auth
AUTH_JWKS_URL=http://localhost:3103/api/auth/jwks.json
# Site rebuild: leave the repository empty to only log the requests.
SITE_BUILD_REPOSITORY=
LOG_LEVEL=info
NODE_ENV=development
