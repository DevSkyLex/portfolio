# Development without Docker: copy to .env (not versioned). Production values come from Docker secrets.
CONTENT_PORT=3101
CONTENT_DATABASE_URL=pglite:.data/content
# Same issuer as IDENTITY_ISSUER; JWKS read directly from the identity service.
AUTH_ISSUER=http://localhost:4200/api/auth
AUTH_JWKS_URL=http://localhost:3103/api/auth/jwks.json
# Site rebuild: leave the repository empty to only log the requests.
SITE_BUILD_REPOSITORY=
# Uploaded media (D40): directory of the WebP files, required in production; defaults to .data/media
# outside production. Serve /media/ from this service only with nx serve behind the Angular proxy.
CONTENT_MEDIA_DIR=.data/media
CONTENT_MEDIA_SERVE=true
# SEO dashboard (D47): every source is optional; an empty value leaves its section "not-configured".
# Service account key file (JSON), read on the first refresh only. Search Console and GA4 need it.
SEO_GOOGLE_CREDENTIALS_PATH=
# Search Console property: sc-domain:<domain> or a URL prefix ending with /.
SEO_SEARCH_CONSOLE_PROPERTY=
# Numeric GA4 property id (Admin > Property details), not the G- measurement id.
SEO_GA4_PROPERTY_ID=
# PageSpeed Insights API key (production: SEO_PAGESPEED_API_KEY_FILE, a Docker secret).
SEO_PAGESPEED_API_KEY=
# Key URLs measured by PageSpeed Insights, comma-separated; empty: home FR/EN and the first project.
SEO_WEB_VITALS_URLS=
SEO_SITE_ORIGIN=https://valentin-fortin.pro
LOG_LEVEL=info
NODE_ENV=development
