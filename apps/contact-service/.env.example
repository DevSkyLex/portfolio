# Development without Docker: copy to .env (not versioned). Production values come from Docker secrets.
CONTACT_PORT=3102
CONTACT_DATABASE_URL=pglite:.data/contact
# `json:` logs the notification instead of sending it.
CONTACT_SMTP_URL=json:
CONTACT_MAIL_FROM=Portfolio <no-reply@localhost>
CONTACT_NOTIFY_TO=owner@example.com
# HMAC key of the client fingerprints (at least 32 characters): generate your own, e.g. `openssl rand -hex 32`.
CONTACT_CLIENT_KEY_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=http://localhost:4200/api/auth
AUTH_JWKS_URL=http://localhost:3103/api/auth/jwks.json
LOG_LEVEL=info
NODE_ENV=development
