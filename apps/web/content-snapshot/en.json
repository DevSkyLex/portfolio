          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "This data is only used to reply to your message. The processing is based on the publisher's legitimate interest in answering the requests sent to them (article 6.1.f of the GDPR)."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Recipients"
