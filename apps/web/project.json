{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:app", "platform:web", "layer:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": ["apps/web/src/styles.css"],
        "server": "apps/web/src/main.server.ts",
        "outputMode": "static",
        "localize": true,
        "i18nMissingTranslation": "error",
        "polyfills": ["@angular/localize/init"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["fr"]
        }
      },
      "inputs": ["production", "^production", "{projectRoot}/content-snapshot/*.json"]
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "coverageInclude": ["apps/web/src/**/*.ts"],
        "coverageExclude": [
          "apps/web/src/**/testing/**",
          "apps/web/src/**/*.spec.ts",
          "apps/web/src/main.ts",
          "apps/web/src/main.server.ts"
        ],
        "coverageReporters": ["text", "html", "lcov", "json-summary"],
        "coverageThresholds": {
          "lines": 90,
          "branches": 80
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    },
    "content-snapshot": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["test-snapshot"],
      "options": {
        "command": "node apps/web/scripts/fetch-content-snapshot.mjs"
      }
    },
    "test-snapshot": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/scripts/**/*.mjs", "sharedGlobals"],
      "options": {
        "command": "node --test apps/web/scripts/testing/fetch-content-snapshot.test.mjs"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web:build",
        "format": "xlf",
        "outputPath": "apps/web/src/locale"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web/tsconfig.app.json --noEmit"
      },
      "dependsOn": ["typecheck-spec"]
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p apps/web/tsconfig.spec.json --noEmit"
      }
    }
  },
  "i18n": {
    "sourceLocale": {
      "code": "fr",
      "subPath": ""
    },
    "locales": {
      "en": {
        "translation": "apps/web/src/locale/messages.en.xlf",
        "subPath": "en"
      }
    }
  }
}
