{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:app", "platform:web", "layer:app"],
  "cli": {
    "cache": {
      "enabled": true,
      "environment": "all"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/web",
          "media": "assets"
        },
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": [
          "apps/web/src/styles.css",
          {
            "input": "apps/web/src/admin.css",
            "bundleName": "admin",
            "inject": false
          }
        ],
        "server": "apps/web/src/main.server.ts",
        "outputMode": "server",
        "ssr": {
          "entry": "apps/web/src/server.ts"
        },
        "localize": true,
        "i18nMissingTranslation": "error",
        "polyfills": ["@angular/localize/init"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "e2e": {
          "outputPath": {
            "base": "dist/apps/web-e2e-site",
            "media": "assets"
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "fileReplacements": [
            {
              "replace": "apps/web/src/environments/audience-measurement.ts",
              "with": "apps/web/src/environments/audience-measurement.e2e.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["fr"]
        }
      },
      "inputs": ["production", "^production"]
    },
    "e2e-site": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["npx nx run web:build:e2e"],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "coverageInclude": ["apps/web/src/**/*.ts"],
        "coverageExclude": [
          "apps/web/src/**/testing/**",
          "apps/web/src/**/*.spec.ts",
          "apps/web/src/main.ts",
          "apps/web/src/main.server.ts",
          "apps/web/src/server.ts",
          "apps/web/src/environments/audience-measurement.e2e.ts"
        ],
        "coverageReporters": ["text", "html", "lcov", "json-summary"],
        "coverageThresholds": {
          "lines": 90,
          "branches": 80
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web:build",
        "format": "xlf",
        "outputPath": "apps/web/src/locale"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web/tsconfig.app.json --noEmit"
      },
      "dependsOn": ["typecheck-spec"]
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p apps/web/tsconfig.spec.json --noEmit"
      }
    },
    "serve-ssr": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/web/server/server.mjs"
      }
    }
  },
  "i18n": {
    "sourceLocale": {
      "code": "fr",
      "subPath": "fr"
    },
    "locales": {
      "en": {
        "translation": "apps/web/src/locale/messages.en.xlf",
        "subPath": "en"
      }
    }
  }
}
