      "@vfortin/content-web-ui": ["./libs/frontend/content/ui/src/index.ts"],
      "@vfortin/content-web-feature": ["./libs/frontend/content/feature/src/index.ts"],
      "@vfortin/web-shell": ["./libs/frontend/shell/src/index.ts"],
      "@vfortin/web-shell/server": ["./libs/frontend/shell/src/server.ts"],
      "@vfortin/content-web-data-access/admin": [
        "./libs/frontend/content/data-access/src/admin.ts"
      ],
      "@vfortin/content-web-data-access/navigation": [
        "./libs/frontend/content/data-access/src/navigation.ts"
      ],
      "@vfortin/content-web-data-access/server": [
