      "@internal/content-web-model/*": ["./libs/frontend/content/model/src/*"],
      "@internal/content-web-ui/*": ["./libs/frontend/content/ui/src/*"],
      "@internal/design-tokens/*": ["./libs/frontend/design-tokens/src/*"],
      "@internal/identity-adapters-in/*": ["./libs/backend/identity/adapters-in/src/*"],
      "@internal/identity-adapters-out/*": ["./libs/backend/identity/adapters-out/src/*"],
      "@internal/identity-application/*": ["./libs/backend/identity/application/src/*"],
      "@internal/identity-composition/*": ["./libs/backend/identity/composition/src/*"],
      "@internal/identity-contracts/*": ["./libs/contracts/identity/src/*"],
      "@internal/identity-domain/*": ["./libs/backend/identity/domain/src/*"],
      "@internal/identity-service/*": ["./apps/identity-service/src/*"],
      "@internal/identity-web-data-access/*": ["./libs/frontend/identity/data-access/src/*"],
      "@internal/identity-web-feature/*": ["./libs/frontend/identity/feature/src/*"],
      "@internal/legal-web-feature/*": ["./libs/frontend/legal/feature/src/*"],
      "@internal/ui/*": ["./libs/frontend/ui/src/*"],
      "@internal/web-e2e/*": ["./apps/web-e2e/src/*"],
      "@internal/web-http/*": ["./libs/frontend/http/src/*"],
      "@internal/web-shell/*": ["./libs/frontend/shell/src/*"],
      "@internal/web-snapshot/*": ["./apps/web/content-snapshot/*"],
      "@internal/web/*": ["./apps/web/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
