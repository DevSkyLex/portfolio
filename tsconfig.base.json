      "@internal/backend-config/*": ["./libs/backend/platform/config/src/*"],
      "@internal/backend-http/*": ["./libs/backend/platform/http/src/*"],
      "@internal/backend-observability/*": ["./libs/backend/platform/observability/src/*"],
      "@internal/backend-persistence/*": ["./libs/backend/platform/persistence/src/*"],
      "@internal/contact-adapters-in/*": ["./libs/backend/contact/adapters-in/src/*"],
      "@internal/contact-adapters-out/*": ["./libs/backend/contact/adapters-out/src/*"],
      "@internal/contact-application/*": ["./libs/backend/contact/application/src/*"],
      "@internal/contact-composition/*": ["./libs/backend/contact/composition/src/*"],
      "@internal/contact-contracts/*": ["./libs/contracts/contact/src/*"],
      "@internal/contact-domain/*": ["./libs/backend/contact/domain/src/*"],
      "@internal/contact-service/*": ["./apps/contact-service/src/*"],
      "@internal/contact-web-data-access/*": ["./libs/frontend/contact/data-access/src/*"],
      "@internal/contact-web-feature-admin/*": ["./libs/frontend/contact/feature-admin/src/*"],
      "@internal/contact-web-feature/*": ["./libs/frontend/contact/feature/src/*"],
      "@internal/content-adapters-in/*": ["./libs/backend/content/adapters-in/src/*"],
      "@internal/content-adapters-out/*": ["./libs/backend/content/adapters-out/src/*"],
      "@internal/content-application/*": ["./libs/backend/content/application/src/*"],
      "@internal/content-composition/*": ["./libs/backend/content/composition/src/*"],
      "@internal/content-contracts/*": ["./libs/contracts/content/src/*"],
      "@internal/content-domain/*": ["./libs/backend/content/domain/src/*"],
      "@internal/content-service/*": ["./apps/content-service/src/*"],
