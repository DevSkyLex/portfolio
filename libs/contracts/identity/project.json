{
  "name": "identity-contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contracts/identity/src",
  "projectType": "library",
  "tags": ["scope:identity", "platform:neutral", "layer:contracts"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/contracts/identity/tsconfig.lib.json --noEmit"
      },
      "dependsOn": ["typecheck-spec"]
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p libs/contracts/identity/tsconfig.spec.json --noEmit"
      }
    }
  }
}
