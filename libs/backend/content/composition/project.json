{
  "name": "content-composition",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/content/composition/src",
  "projectType": "library",
  "tags": ["scope:content", "platform:server", "layer:composition"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/backend/content/composition/tsconfig.lib.json --noEmit"
      },
      "dependsOn": ["typecheck-spec"]
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p libs/backend/content/composition/tsconfig.spec.json --noEmit"
      }
    }
  }
}
