{
  "name": "web-http",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/http/src",
  "prefix": "ui",
  "projectType": "library",
  "tags": ["scope:platform", "platform:web", "layer:platform"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/frontend/http/tsconfig.lib.json --noEmit"
      },
      "dependsOn": ["typecheck-spec"]
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p libs/frontend/http/tsconfig.spec.json --noEmit"
      }
    }
  }
}
